server {
    listen 80;
    server_name localhost;

    root /usr/share/nginx/html;
    index index.html;

    # Gzip compression
    gzip on;
    gzip_min_length 1000;
    gzip_proxied expired no-cache no-store private auth;
    gzip_types text/plain text/css application/json application/javascript application/x-javascript text/xml application/xml application/xml+rss text/javascript;

    location / {
        try_files $uri $uri/ /index.html;
        
        # Replace the placeholder in index.html with the actual environment variable
        # The ${KEYCLOAK_URL} will be replaced by envsubst before Nginx starts
        sub_filter '__KEYCLOAK_URL_PLACEHOLDER__' '${KEYCLOAK_URL}';
        sub_filter '__ENABLE_AUTH_PLACEHOLDER__' '${ENABLE_AUTH}';
        sub_filter_once on;
    }

    # Proxy for Places API
    # No trailing slash on location or proxy_pass — nginx will forward the full
    # URI (/api/places, /api/places?category=gym, /api/places/123) unchanged.
    location /api/places {
        proxy_pass ${PLACES_API_URL};
        proxy_set_header Host $host;
        proxy_ssl_server_name on;
    }

    location /api/metro {
        proxy_pass ${PLACES_API_URL};
        proxy_set_header Host $host;
        proxy_ssl_server_name on;
    }

    location /api/heatmap {
        proxy_pass ${PLACES_API_URL};
        proxy_set_header Host $host;
        proxy_ssl_server_name on;
    }

    # Proxy for Tile Server
    location /api/tiles {
        proxy_pass ${TILES_API_URL};
        proxy_set_header Host $host;
        proxy_ssl_server_name on;
    }

    location /api/martin {
        rewrite ^/api/martin(/.*)$ $1 break;
        proxy_pass ${MARTIN_API_URL};
        proxy_set_header Host $host;
        proxy_ssl_server_name on;
    }



    # Cache static assets
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg)$ {
        expires 1y;
        add_header Cache-Control "public, no-transform";
    }

    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}
