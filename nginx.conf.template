proxy_cache_path /tmp/tile_cache levels=1:2 keys_zone=tiles:10m max_size=500m inactive=24h;

server {
    listen 80;
    server_name localhost;

    root /usr/share/nginx/html;
    index index.html;

    # Gzip compression
    gzip on;
    gzip_min_length 256;
    gzip_proxied any;
    gzip_types text/plain text/css application/json application/javascript application/x-javascript text/xml application/xml application/xml+rss text/javascript application/x-protobuf application/vnd.mapbox-vector-tile;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy for Places API
    # No trailing slash on location or proxy_pass — nginx will forward the full
    # URI (/api/places, /api/places?category=gym, /api/places/123) unchanged.
    location /api/places {
        proxy_pass ${PLACES_API_URL};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
    }

    location /api/metro {
        proxy_pass ${PLACES_API_URL};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
    }

    location /api/heatmap {
        proxy_pass ${PLACES_API_URL};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
    }

    location /api/parking-zones {
        proxy_pass ${PLACES_API_URL};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
    }

    location /api/sofiaplan {
        proxy_pass ${PLACES_API_URL};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
    }

    location /api/retail-listings {
        proxy_pass ${PLACES_API_URL};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
    }

    location /api/adres-locations {
        proxy_pass ${PLACES_API_URL};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
    }

    # Proxy for Tile Server
    location /api/tiles {
        proxy_pass ${TILES_API_URL};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
    }

    # Proxy for Martin — cached tiles
    location /api/martin {
        rewrite ^/api/martin(/.*)$ $1 break;
        proxy_pass ${MARTIN_API_URL};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;

        # Cache tiles for 1 hour — huge win on Raspberry Pi
        proxy_cache tiles;
        proxy_cache_valid 200 1h;
        proxy_cache_use_stale error timeout updating;
        proxy_cache_key $uri;
        add_header X-Cache-Status $upstream_cache_status;
    }

    # Cache static assets
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg)$ {
        expires 1y;
        add_header Cache-Control "public, no-transform";
    }

    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}
